		"IOEXP2_INT#_1V8",
		"ENET2_TD3",
		"ENET2_TD2",
		"ENET2_TD1",
		"ENET2_TD0",
		"ENET2_TX_CTL",
		"ENET2_TXC",
		"ENET2_RX_CTL",
